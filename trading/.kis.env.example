# Korea Investment & Securities (KIS) Open API credentials.
# Copy this file to trading/.kis.env and fill in real values.
# trading/.kis.env is ignored by Git.

# Select one of: real, demo_stock, demo_derivatives.
KIS_PROFILE=real

# Backward-compatible default used by older scripts.
KIS_APP_KEY=YOUR_KIS_REAL_APP_KEY
KIS_APP_SECRET=YOUR_KIS_REAL_APP_SECRET

# Real account.
KIS_REAL_APP_KEY=YOUR_KIS_REAL_APP_KEY
KIS_REAL_APP_SECRET=YOUR_KIS_REAL_APP_SECRET

# Paper domestic stocks.
KIS_DEMO_STOCK_APP_KEY=YOUR_KIS_DEMO_STOCK_APP_KEY
KIS_DEMO_STOCK_APP_SECRET=YOUR_KIS_DEMO_STOCK_APP_SECRET

# Paper derivatives/futures/options.
KIS_DEMO_DERIVATIVES_APP_KEY=YOUR_KIS_DEMO_DERIVATIVES_APP_KEY
KIS_DEMO_DERIVATIVES_APP_SECRET=YOUR_KIS_DEMO_DERIVATIVES_APP_SECRET

# Legacy single-key mode:
# Omit KIS_PROFILE, then set KIS_APP_KEY/KIS_APP_SECRET and KIS_ENV=real|demo.
# KIS_ENV=demo
