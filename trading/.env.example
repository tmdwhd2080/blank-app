# 키움 REST API 인증 정보 (예시 — 실제 키 아님)
# 이 파일을 trading/.env 로 복사한 뒤 실제 값을 채우세요. trading/.env 는 git에 커밋되지 않습니다.
# 실전: https://openapi.kiwoom.com 에서 발급 / 모의: 동일 사이트에서 모의투자용 키 별도 발급
KIWOOM_APP_KEY=YOUR_KIWOOM_APP_KEY
KIWOOM_APP_SECRET=YOUR_KIWOOM_APP_SECRET

# 환경 토글: real (실전) / paper (모의)
KIWOOM_ENV=paper

# 토큰 캐시 위치 (기본: ~/.kiwoom/token_real.json)
# KIWOOM_TOKEN_CACHE=

# 계좌번호 — 8자리 기본 + 2자리 상품코드 = 10자리. 하이픈/공백 없이 숫자 10자리.
KIWOOM_ACCOUNT_NO=0000000000
