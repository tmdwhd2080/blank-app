// Data indices: [name, market(0=KOSPI,1=KOSDAQ), sectorIdx, dropAvg, riseAvg, score, quadrant, ex0303, ex0304, ex0305, ex0306, ex0309]
const DATES = ["0303","0304","0305","0306","0309"];
const DATE_LABELS = {"0303":"3/3(월)","0304":"3/4(화)","0305":"3/5(수)","0306":"3/6(목)","0309":"3/9(월)"};
const DATE_TYPE = {"0303":"drop","0304":"drop","0305":"rise","0306":"rise","0309":"drop"};
const MKT = ["KOSPI","KOSDAQ"];
const QNAMES = {1:"Q1 방어+반등",2:"Q2 약세→반등",3:"Q3 양쪽약세",4:"Q4 방어→약반등"};
const QCOLORS = {1:"#10b981",2:"#f59e0b",3:"#ef4444",4:"#6366f1"};
const MCOLORS = ["#3b82f6","#f97316"];

function Tip({active,payload}) {
  if(!active||!payload?.length) return null;
  const d=payload[0].payload;
  return (
    <div style={{background:"rgba(10,18,36,0.96)",border:"1px solid #334155",borderRadius:8,padding:"10px 14px",fontSize:11,color:"#e2e8f0",maxWidth:260,lineHeight:1.6}}>
      <div style={{fontWeight:700,fontSize:13,color:"#f8fafc"}}>{d.name||d.n}</div>
      {d.mkt!==undefined&&<div style={{color:MCOLORS[d.mkt]}}>{MKT[d.mkt]} · {DATA.S[d.si]}</div>}
      {d.sector&&<div style={{color:"#94a3b8"}}>{d.sector}</div>}
      {d.x!==undefined&&<div>X: <b style={{color:d.x>0?"#34d399":"#f87171"}}>{d.x>0?"+":""}{d.x}%</b></div>}
      {d.y!==undefined&&<div>Y: <b style={{color:d.y>0?"#34d399":"#f87171"}}>{d.y>0?"+":""}{d.y}%</b></div>}
      {d.sc!==undefined&&<div>종합스코어: <b style={{color:d.sc>0?"#34d399":"#f87171"}}>{d.sc}</b></div>}
      {d.q&&<div style={{color:QCOLORS[d.q]}}>■ {QNAMES[d.q]}</div>}
    </div>
  );
}

function Btn({active,color,children,...props}) {
  return <button {...props} style={{padding:"5px 12px",borderRadius:6,border:"none",fontSize:11,fontWeight:600,cursor:"pointer",
    background:active?(color||"#3b82f6"):"#1e293b",color:active?"#fff":(color||"#94a3b8"),transition:"all 0.15s",...(props.style||{})}}>{children}</button>;
}

function StatCard({label,value,sub,color}) {
  return (
    <div style={{background:"rgba(30,41,59,0.5)",borderRadius:8,padding:"10px 14px",border:"1px solid #1e293b",flex:1,minWidth:100}}>
      <div style={{fontSize:10,color:"#64748b"}}>{label}</div>
      <div style={{fontSize:18,fontWeight:700,color:color||"#f8fafc"}}>{value}</div>
      {sub&&<div style={{fontSize:10,color:"#94a3b8"}}>{sub}</div>}
    </div>
  );
}

// ─── Tab 1: Overview ───
function OverviewTab() {
  const idxData = DATES.map(d => ({
    date: DATE_LABELS[d],
    KOSPI: DATA.I.kospi[d.slice(1)],
    KOSDAQ: DATA.I.kosdaq[d.slice(1)],
    type: DATE_TYPE[d],
  }));
  const qCounts = {};
  DATA.D.forEach(s => {
    const key = `${s[1]}_${s[6]}`;
    qCounts[key] = (qCounts[key]||0)+1;
  });
  return (
    <div>
      <div style={{display:"flex",gap:8,flexWrap:"wrap",marginBottom:16}}>
        {DATES.map(d => {
          const ki = DATA.I.kospi[d.slice(1)], kd = DATA.I.kosdaq[d.slice(1)];
          return (
            <div key={d} style={{background:DATE_TYPE[d]==="drop"?"rgba(239,68,68,0.08)":"rgba(16,185,129,0.08)",
              borderRadius:8,padding:"10px 14px",border:`1px solid ${DATE_TYPE[d]==="drop"?"#7f1d1d":"#064e3b"}`,flex:1,minWidth:140}}>
              <div style={{fontSize:11,color:"#94a3b8",marginBottom:2}}>{DATE_LABELS[d]} <span style={{fontSize:9,color:DATE_TYPE[d]==="drop"?"#f87171":"#34d399"}}>{DATE_TYPE[d]==="drop"?"▼ 하락":"▲ 반등"}</span></div>
              <div style={{display:"flex",gap:12}}>
                <div><span style={{fontSize:9,color:"#64748b"}}>KS </span><span style={{fontSize:16,fontWeight:700,color:ki>0?"#34d399":"#f87171"}}>{ki>0?"+":""}{ki}%</span></div>
                <div><span style={{fontSize:9,color:"#64748b"}}>KQ </span><span style={{fontSize:16,fontWeight:700,color:kd>0?"#34d399":"#f87171"}}>{kd>0?"+":""}{kd}%</span></div>
              </div>
            </div>
          );
        })}
      </div>
      <ResponsiveContainer width="100%" height={200}>
        <BarChart data={idxData} barGap={2}>
          <CartesianGrid strokeDasharray="3 3" stroke="#1e293b"/>
          <XAxis dataKey="date" tick={{fill:"#94a3b8",fontSize:10}}/>
          <YAxis tick={{fill:"#94a3b8",fontSize:10}} domain={['auto','auto']}/>
          <Tooltip contentStyle={{background:"#0f172a",border:"1px solid #334155",borderRadius:8,fontSize:11}}/>
          <ReferenceLine y={0} stroke="#475569"/>
          <Bar dataKey="KOSPI" fill="#3b82f6" radius={[3,3,0,0]}/>
          <Bar dataKey="KOSDAQ" fill="#f97316" radius={[3,3,0,0]}/>
          <Legend wrapperStyle={{fontSize:10}}/>
        </BarChart>
      </ResponsiveContainer>
      <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:12,marginTop:16}}>
        {[0,1].map(mi => {
          const total = DATA.D.filter(s=>s[1]===mi).length;
          return (
            <div key={mi} style={{background:"rgba(30,41,59,0.4)",borderRadius:8,padding:12,border:"1px solid #1e293b"}}>
              <div style={{fontSize:12,color:MCOLORS[mi],fontWeight:700,marginBottom:8}}>{MKT[mi]} 사분면 ({total}종목)</div>
              {[1,2,3,4].map(qi => {
                const cnt = qCounts[`${mi}_${qi}`]||0;
                const pct = (cnt/total*100).toFixed(1);
                return (
                  <div key={qi} style={{marginBottom:5}}>
                    <div style={{display:"flex",justifyContent:"space-between",fontSize:10,color:"#cbd5e1",marginBottom:1}}>
                      <span style={{color:QCOLORS[qi],fontWeight:600}}>{QNAMES[qi]}</span>
                      <span>{cnt} ({pct}%)</span>
                    </div>
                    <div style={{height:5,background:"#0f172a",borderRadius:3}}>
                      <div style={{height:5,background:QCOLORS[qi],borderRadius:3,width:`${pct}%`,opacity:0.7}}/>
                    </div>
                  </div>
                );
              })}
            </div>
          );
        })}
      </div>
    </div>
  );
}

// ─── Tab 2: Drop vs Rise Scatter ───
function ScatterTab() {
  const [mkt, setMkt] = useState(-1);
  const [qf, setQf] = useState(0);
  const [hovered, setHovered] = useState(null);

  const points = useMemo(() => {
    return DATA.D
      .filter(s => (mkt===-1 || s[1]===mkt) && (qf===0 || s[6]===qf))
      .map(s => ({name:s[0],mkt:s[1],si:s[2],x:s[3],y:s[4],sc:s[5],q:s[6]}));
  }, [mkt, qf]);

  const stats = useMemo(() => {
    const qs = {1:0,2:0,3:0,4:0};
    points.forEach(p => qs[p.q]++);
    return qs;
  }, [points]);

  return (
    <div>
      <div style={{display:"flex",gap:6,flexWrap:"wrap",marginBottom:12,alignItems:"center"}}>
        <span style={{fontSize:10,color:"#64748b",marginRight:4}}>시장:</span>
        {[[-1,"전체"],[0,"KOSPI"],[1,"KOSDAQ"]].map(([v,l])=>(
          <Btn key={v} active={mkt===v} onClick={()=>setMkt(v)}>{l}</Btn>
        ))}
        <div style={{width:1,height:20,background:"#334155",margin:"0 4px"}}/>
        <span style={{fontSize:10,color:"#64748b",marginRight:4}}>사분면:</span>
        {[[0,"전체"],[1,"Q1"],[2,"Q2"],[3,"Q3"],[4,"Q4"]].map(([v,l])=>(
          <Btn key={v} active={qf===v} color={QCOLORS[v]||undefined} onClick={()=>setQf(v)}>{l} {v>0?QNAMES[v].split(" ")[1]:""}</Btn>
        ))}
      </div>
      <div style={{display:"flex",gap:8,marginBottom:12,flexWrap:"wrap"}}>
        {[1,2,3,4].map(qi=>(
          <div key={qi} style={{fontSize:10,color:QCOLORS[qi],fontWeight:600}}>■ {QNAMES[qi]}: {stats[qi]}종목</div>
        ))}
        <div style={{fontSize:10,color:"#64748b",marginLeft:"auto"}}>총 {points.length}종목</div>
      </div>
      <div style={{fontSize:10,color:"#475569",marginBottom:6}}>X: 하락일(3/3,3/4,3/9) 평균 초과수익률 | Y: 반등일(3/5,3/6) 평균 초과수익률 | 점 크기 = |스코어|</div>
      <ResponsiveContainer width="100%" height={460}>
        <ScatterChart margin={{top:10,right:20,bottom:20,left:10}}>
          <CartesianGrid strokeDasharray="3 3" stroke="#1e293b"/>
          <XAxis type="number" dataKey="x" tick={{fill:"#94a3b8",fontSize:9}} domain={['auto','auto']}
            label={{value:"← 하락일 평균 초과수익률(%) →",position:"bottom",offset:2,fill:"#64748b",fontSize:10}}/>
          <YAxis type="number" dataKey="y" tick={{fill:"#94a3b8",fontSize:9}} domain={['auto','auto']}
            label={{value:"← 반등일 초과수익률(%) →",angle:-90,position:"left",offset:-2,fill:"#64748b",fontSize:10}}/>
          <ReferenceLine x={0} stroke="#475569" strokeDasharray="4 4"/>
          <ReferenceLine y={0} stroke="#475569" strokeDasharray="4 4"/>
          <Tooltip content={<Tip/>}/>
          <Scatter data={points} isAnimationActive={false}>
            {points.map((p,i)=>(
              <Cell key={i} fill={QCOLORS[p.q]} fillOpacity={0.55} r={Math.min(Math.max(Math.abs(p.sc)*0.35+1.5,2),10)}/>
            ))}
          </Scatter>
        </ScatterChart>
      </ResponsiveContainer>
    </div>
  );
}

// ─── Tab 3: Daily Scatter ───
function DailyTab() {
  const [dateIdx, setDateIdx] = useState(0);
  const [mkt, setMkt] = useState(-1);
  const [mode, setMode] = useState("single"); // single | compare
  const [dateA, setDateA] = useState("0303");
  const [dateB, setDateB] = useState("0305");

  const singlePoints = useMemo(() => {
    const di = 7 + dateIdx;
    return DATA.D
      .filter(s => s[di]!==null && (mkt===-1||s[1]===mkt))
      .map(s => ({name:s[0],mkt:s[1],si:s[2],x:s[di],y:0,q:s[6],sc:s[5]}));
  }, [dateIdx, mkt]);

  const comparePoints = useMemo(() => {
    const diA = 7 + DATES.indexOf(dateA);
    const diB = 7 + DATES.indexOf(dateB);
    return DATA.D
      .filter(s => s[diA]!==null && s[diB]!==null && (mkt===-1||s[1]===mkt))
      .map(s => ({name:s[0],mkt:s[1],si:s[2],x:s[diA],y:s[diB],q:s[6],sc:s[5]}));
  }, [dateA, dateB, mkt]);

  // Sector averages for single date
  const sectorAvg = useMemo(() => {
    if (mode !== "single") return [];
    const di = 7 + dateIdx;
    const groups = {};
    DATA.D.filter(s => s[di]!==null && (mkt===-1||s[1]===mkt)).forEach(s => {
      const key = `${s[1]}_${s[2]}`;
      if (!groups[key]) groups[key] = {m:s[1],si:s[2],sum:0,cnt:0,alpha:0};
      groups[key].sum += s[di];
      groups[key].cnt++;
      if (s[di]>0) groups[key].alpha++;
    });
    return Object.values(groups)
      .map(g => ({...g, avg:+(g.sum/g.cnt).toFixed(2), name:`${MKT[g.m]} ${DATA.S[g.si]}`, pct:+(g.alpha/g.cnt*100).toFixed(1)}))
      .sort((a,b) => b.avg - a.avg);
  }, [dateIdx, mkt, mode]);

  const dateKey = DATES[dateIdx];
  const ksRet = DATA.I.kospi[dateKey.slice(1)];
  const kqRet = DATA.I.kosdaq[dateKey.slice(1)];

  return (
    <div>
      <div style={{display:"flex",gap:6,marginBottom:12,alignItems:"center",flexWrap:"wrap"}}>
        <Btn active={mode==="single"} onClick={()=>setMode("single")}>단일 날짜</Btn>
        <Btn active={mode==="compare"} onClick={()=>setMode("compare")}>날짜 비교</Btn>
        <div style={{width:1,height:20,background:"#334155",margin:"0 4px"}}/>
        {[[-1,"전체"],[0,"KOSPI"],[1,"KOSDAQ"]].map(([v,l])=>(
          <Btn key={v} active={mkt===v} onClick={()=>setMkt(v)}>{l}</Btn>
        ))}
      </div>

      {mode === "single" ? (
        <div>
          <div style={{display:"flex",gap:4,marginBottom:10}}>
            {DATES.map((d,i)=>(
              <Btn key={d} active={dateIdx===i} color={DATE_TYPE[d]==="drop"?"#ef4444":"#10b981"} onClick={()=>setDateIdx(i)}>
                {DATE_LABELS[d]} ({DATE_TYPE[d]==="drop"?"▼":"▲"})
              </Btn>
            ))}
          </div>
          <div style={{display:"flex",gap:8,marginBottom:12}}>
            <StatCard label="KOSPI" value={`${ksRet>0?"+":""}${ksRet}%`} color={ksRet>0?"#34d399":"#f87171"}/>
            <StatCard label="KOSDAQ" value={`${kqRet>0?"+":""}${kqRet}%`} color={kqRet>0?"#34d399":"#f87171"}/>
            <StatCard label="표시 종목" value={singlePoints.length}/>
            <StatCard label="알파(>0)" value={singlePoints.filter(p=>p.x>0).length} sub={`${(singlePoints.filter(p=>p.x>0).length/singlePoints.length*100).toFixed(1)}%`} color="#34d399"/>
          </div>

          <div style={{fontSize:10,color:"#475569",marginBottom:6}}>종목별 초과수익률 분포 (X축: 초과수익률%)</div>
          <ResponsiveContainer width="100%" height={200}>
            <ScatterChart margin={{top:5,right:20,bottom:10,left:10}}>
              <CartesianGrid strokeDasharray="3 3" stroke="#1e293b"/>
              <XAxis type="number" dataKey="x" tick={{fill:"#94a3b8",fontSize:9}} domain={['auto','auto']}
                label={{value:"초과수익률(%) →",position:"bottom",fill:"#64748b",fontSize:9}}/>
              <YAxis type="number" dataKey="y" tick={false} hide/>
              <ReferenceLine x={0} stroke="#ef4444" strokeWidth={1.5}/>
              <Tooltip content={<Tip/>}/>
              <Scatter data={singlePoints.map((p,i)=>({...p,y:Math.random()*10-5}))} isAnimationActive={false}>
                {singlePoints.map((p,i)=>(<Cell key={i} fill={p.x>0?"#34d399":"#f87171"} fillOpacity={0.4} r={2}/>))}
              </Scatter>
            </ScatterChart>
          </ResponsiveContainer>

          <div style={{fontSize:12,color:"#e2e8f0",fontWeight:600,margin:"16px 0 8px"}}>섹터별 평균 초과수익률</div>
          <div style={{maxHeight:280,overflow:"auto",borderRadius:8,border:"1px solid #1e293b"}}>
            <table style={{width:"100%",borderCollapse:"collapse",fontSize:10}}>
              <thead><tr style={{background:"#1e293b",position:"sticky",top:0}}>
                {["섹터","평균초과수익률","알파비율","종목수"].map(h=>(
                  <th key={h} style={{padding:"6px 8px",textAlign:"left",color:"#94a3b8",fontWeight:600}}>{h}</th>
                ))}
              </tr></thead>
              <tbody>{sectorAvg.map((s,i)=>(
                <tr key={i} style={{borderBottom:"1px solid #0f172a",background:i%2===0?"rgba(15,23,42,0.4)":"transparent"}}>
                  <td style={{padding:"5px 8px",color:"#e2e8f0"}}><span style={{color:MCOLORS[s.m],fontSize:9,fontWeight:600}}>{MKT[s.m]}</span> {DATA.S[s.si]}</td>
                  <td style={{padding:"5px 8px"}}><span style={{color:s.avg>0?"#34d399":"#f87171",fontWeight:700}}>{s.avg>0?"+":""}{s.avg}%</span></td>
                  <td style={{padding:"5px 8px",color:"#94a3b8"}}>{s.pct}%</td>
                  <td style={{padding:"5px 8px",color:"#64748b"}}>{s.cnt}</td>
                </tr>
              ))}</tbody>
            </table>
          </div>
        </div>
      ) : (
        <div>
          <div style={{display:"flex",gap:8,marginBottom:12,alignItems:"center",flexWrap:"wrap"}}>
            <span style={{fontSize:10,color:"#64748b"}}>X축:</span>
            {DATES.map(d=>(
              <Btn key={d} active={dateA===d} color={DATE_TYPE[d]==="drop"?"#ef4444":"#10b981"} onClick={()=>setDateA(d)}>
                {DATE_LABELS[d]}
              </Btn>
            ))}
            <span style={{fontSize:10,color:"#64748b",marginLeft:8}}>Y축:</span>
            {DATES.map(d=>(
              <Btn key={d} active={dateB===d} color={DATE_TYPE[d]==="drop"?"#ef4444":"#10b981"} onClick={()=>setDateB(d)}>
                {DATE_LABELS[d]}
              </Btn>
            ))}
          </div>
          <div style={{fontSize:10,color:"#475569",marginBottom:6}}>
            X: {DATE_LABELS[dateA]} 초과수익률 | Y: {DATE_LABELS[dateB]} 초과수익률 | {comparePoints.length}종목
          </div>
          <ResponsiveContainer width="100%" height={440}>
            <ScatterChart margin={{top:10,right:20,bottom:20,left:10}}>
              <CartesianGrid strokeDasharray="3 3" stroke="#1e293b"/>
              <XAxis type="number" dataKey="x" tick={{fill:"#94a3b8",fontSize:9}} domain={['auto','auto']}
                label={{value:`${DATE_LABELS[dateA]} 초과수익률(%)`,position:"bottom",fill:"#64748b",fontSize:10}}/>
              <YAxis type="number" dataKey="y" tick={{fill:"#94a3b8",fontSize:9}} domain={['auto','auto']}
                label={{value:`${DATE_LABELS[dateB]} 초과수익률(%)`,angle:-90,position:"left",fill:"#64748b",fontSize:10}}/>
              <ReferenceLine x={0} stroke="#475569" strokeDasharray="4 4"/>
              <ReferenceLine y={0} stroke="#475569" strokeDasharray="4 4"/>
              <Tooltip content={<Tip/>}/>
              <Scatter data={comparePoints} isAnimationActive={false}>
                {comparePoints.map((p,i)=>{
                  const c = p.x>0&&p.y>0?"#10b981":p.x<0&&p.y<0?"#ef4444":"#f59e0b";
                  return <Cell key={i} fill={c} fillOpacity={0.45} r={2.5}/>;
                })}
              </Scatter>
            </ScatterChart>
          </ResponsiveContainer>
          <div style={{display:"flex",gap:12,justifyContent:"center",marginTop:4}}>
            <span style={{fontSize:10,color:"#10b981"}}>■ 양쪽 양수</span>
            <span style={{fontSize:10,color:"#ef4444"}}>■ 양쪽 음수</span>
            <span style={{fontSize:10,color:"#f59e0b"}}>■ 혼합</span>
          </div>
        </div>
      )}
    </div>
  );
}

// ─── Tab 4: Sector Timeseries ───
function SectorTab() {
  const [mkt, setMkt] = useState(0);

  const tsData = useMemo(() => {
    const groups = {};
    DATA.D.filter(s=>s[1]===mkt).forEach(s => {
      const sec = DATA.S[s[2]];
      if(!groups[sec]) groups[sec] = {sec, vals:{}};
      DATES.forEach((d,di) => {
        const v = s[7+di];
        if(v===null) return;
        if(!groups[sec].vals[d]) groups[sec].vals[d] = {sum:0,cnt:0};
        groups[sec].vals[d].sum += v;
        groups[sec].vals[d].cnt++;
      });
    });
    return Object.values(groups).map(g => {
      const avgs = {};
      let totalAvg = 0;
      DATES.forEach(d => {
        if(g.vals[d]) {
          avgs[d] = +(g.vals[d].sum / g.vals[d].cnt).toFixed(2);
          totalAvg += avgs[d];
        }
      });
      return {...g, avgs, totalAvg};
    }).sort((a,b) => b.totalAvg - a.totalAvg);
  }, [mkt]);

  const topSectors = tsData.slice(0,6);
  const botSectors = tsData.slice(-3);
  const highlighted = [...topSectors, ...botSectors];
  const colors = ["#3b82f6","#10b981","#f59e0b","#8b5cf6","#ec4899","#06b6d4","#f87171","#fb923c","#a3e635"];

  const chartData = DATES.map(d => {
    const row = {date: DATE_LABELS[d]};
    highlighted.forEach(s => { row[s.sec] = s.avgs[d]||0; });
    return row;
  });

  // Sector bubble chart: x=avgDropExcess, y=avgRiseExcess
  const bubbleData = useMemo(() => {
    return tsData.map(s => {
      const dropVals = ["0303","0304","0309"].map(d=>s.avgs[d]).filter(v=>v!==undefined);
      const riseVals = ["0305","0306"].map(d=>s.avgs[d]).filter(v=>v!==undefined);
      const dAvg = dropVals.length ? +(dropVals.reduce((a,b)=>a+b,0)/dropVals.length).toFixed(2) : 0;
      const rAvg = riseVals.length ? +(riseVals.reduce((a,b)=>a+b,0)/riseVals.length).toFixed(2) : 0;
      const cnt = Object.values(DATA.D).filter(st=>st[1]===mkt&&st[2]===DATA.S.indexOf(s.sec)).length;
      return {name:s.sec,sector:s.sec,x:dAvg,y:rAvg,cnt,sc:+(dAvg*0.6+rAvg*0.4).toFixed(2)};
    });
  }, [mkt, tsData]);

  return (
    <div>
      <div style={{display:"flex",gap:6,marginBottom:14}}>
        {[0,1].map(v=><Btn key={v} active={mkt===v} color={MCOLORS[v]} onClick={()=>setMkt(v)}>{MKT[v]}</Btn>)}
      </div>

      <div style={{fontSize:12,color:"#e2e8f0",fontWeight:600,marginBottom:8}}>주요 섹터 일별 초과수익률 추이 (상위 6 + 하위 3)</div>
      <ResponsiveContainer width="100%" height={280}>
        <LineChart data={chartData} margin={{top:5,right:20,bottom:5,left:10}}>
          <CartesianGrid strokeDasharray="3 3" stroke="#1e293b"/>
          <XAxis dataKey="date" tick={{fill:"#94a3b8",fontSize:10}}/>
          <YAxis tick={{fill:"#94a3b8",fontSize:10}}/>
          <ReferenceLine y={0} stroke="#475569"/>
          <Tooltip contentStyle={{background:"#0f172a",border:"1px solid #334155",borderRadius:8,fontSize:10}}/>
          <Legend wrapperStyle={{fontSize:9}}/>
          {highlighted.map((s,i)=>(
            <Line key={s.sec} type="monotone" dataKey={s.sec} stroke={colors[i%colors.length]}
              strokeWidth={i<3?2.5:1.5} dot={{r:2.5}} strokeDasharray={i>=6?"5 5":undefined}/>
          ))}
        </LineChart>
      </ResponsiveContainer>

      <div style={{fontSize:12,color:"#e2e8f0",fontWeight:600,margin:"20px 0 8px"}}>섹터별 방어력 vs 반등력</div>
      <div style={{fontSize:10,color:"#475569",marginBottom:6}}>X: 하락일 평균초과수익률 | Y: 반등일 평균초과수익률 | 원크기=종목수</div>
      <ResponsiveContainer width="100%" height={300}>
        <ScatterChart margin={{top:10,right:20,bottom:20,left:10}}>
          <CartesianGrid strokeDasharray="3 3" stroke="#1e293b"/>
          <XAxis type="number" dataKey="x" tick={{fill:"#94a3b8",fontSize:9}}
            label={{value:"평균 방어력(%) →",position:"bottom",fill:"#64748b",fontSize:9}}/>
          <YAxis type="number" dataKey="y" tick={{fill:"#94a3b8",fontSize:9}}
            label={{value:"평균 반등력(%)",angle:-90,position:"left",fill:"#64748b",fontSize:9}}/>
          <ReferenceLine x={0} stroke="#475569" strokeDasharray="4 4"/>
          <ReferenceLine y={0} stroke="#475569" strokeDasharray="4 4"/>
          <Tooltip content={<Tip/>}/>
          <Scatter data={bubbleData} isAnimationActive={false}>
            {bubbleData.map((p,i)=>(
              <Cell key={i} fill={MCOLORS[mkt]} fillOpacity={0.6} r={Math.sqrt(p.cnt)*0.8+3}/>
            ))}
          </Scatter>
        </ScatterChart>
      </ResponsiveContainer>
    </div>
  );
}

// ─── Tab 5: Rankings ───
function RankingTab() {
  const [mkt, setMkt] = useState(-1);
  const [qf, setQf] = useState(0);
  const [sort, setSort] = useState("sc");
  const [limit, setLimit] = useState(50);

  const ranking = useMemo(() => {
    let data = DATA.D
      .filter(s => (mkt===-1||s[1]===mkt) && (qf===0||s[6]===qf))
      .map(s => ({n:s[0],m:s[1],si:s[2],da:s[3],ra:s[4],sc:s[5],q:s[6]}));
    
    if(sort==="sc") data.sort((a,b)=>b.sc-a.sc);
    else if(sort==="da") data.sort((a,b)=>b.da-a.da);
    else if(sort==="ra") data.sort((a,b)=>b.ra-a.ra);
    return data;
  }, [mkt, qf, sort]);

  return (
    <div>
      <div style={{display:"flex",gap:6,flexWrap:"wrap",marginBottom:10,alignItems:"center"}}>
        {[[-1,"전체"],[0,"KOSPI"],[1,"KOSDAQ"]].map(([v,l])=>(
          <Btn key={v} active={mkt===v} onClick={()=>setMkt(v)}>{l}</Btn>
        ))}
        <div style={{width:1,height:20,background:"#334155",margin:"0 2px"}}/>
        {[[0,"전체"],[1,"Q1"],[2,"Q2"],[3,"Q3"],[4,"Q4"]].map(([v,l])=>(
          <Btn key={v} active={qf===v} color={QCOLORS[v]||undefined} onClick={()=>setQf(v)}>{l}</Btn>
        ))}
        <div style={{width:1,height:20,background:"#334155",margin:"0 2px"}}/>
        <span style={{fontSize:10,color:"#64748b"}}>정렬:</span>
        {[["sc","종합"],["da","방어력"],["ra","반등력"]].map(([v,l])=>(
          <Btn key={v} active={sort===v} onClick={()=>setSort(v)}>{l}</Btn>
        ))}
      </div>
      <div style={{fontSize:10,color:"#64748b",marginBottom:8}}>{ranking.length}종목 (상위 {Math.min(limit,ranking.length)}개 표시)
        {limit<ranking.length && <button onClick={()=>setLimit(l=>l+50)} style={{marginLeft:8,background:"none",border:"1px solid #334155",color:"#94a3b8",borderRadius:4,padding:"2px 8px",fontSize:10,cursor:"pointer"}}>더보기</button>}
      </div>
      <div style={{maxHeight:500,overflow:"auto",borderRadius:8,border:"1px solid #1e293b"}}>
        <table style={{width:"100%",borderCollapse:"collapse",fontSize:10}}>
          <thead><tr style={{background:"#1e293b",position:"sticky",top:0,zIndex:1}}>
            {["#","종목","시장","업종","하락방어","반등력","스코어","유형"].map(h=>(
              <th key={h} style={{padding:"6px 6px",textAlign:"left",color:"#94a3b8",fontWeight:600,borderBottom:"1px solid #334155"}}>{h}</th>
            ))}
          </tr></thead>
          <tbody>{ranking.slice(0,limit).map((s,i)=>(
            <tr key={i} style={{borderBottom:"1px solid #0f172a",background:i%2===0?"rgba(15,23,42,0.4)":"transparent"}}>
              <td style={{padding:"4px 6px",color:"#475569"}}>{i+1}</td>
              <td style={{padding:"4px 6px",color:"#f8fafc",fontWeight:600,maxWidth:100,overflow:"hidden",textOverflow:"ellipsis",whiteSpace:"nowrap"}}>{s.n}</td>
              <td style={{padding:"4px 6px",color:MCOLORS[s.m],fontSize:9,fontWeight:600}}>{MKT[s.m]}</td>
              <td style={{padding:"4px 6px",color:"#94a3b8",fontSize:9}}>{DATA.S[s.si]}</td>
              <td style={{padding:"4px 6px",color:s.da>0?"#34d399":"#f87171",fontWeight:600}}>{s.da>0?"+":""}{s.da}%</td>
              <td style={{padding:"4px 6px",color:s.ra>0?"#34d399":"#f87171",fontWeight:600}}>{s.ra>0?"+":""}{s.ra}%</td>
              <td style={{padding:"4px 6px",color:s.sc>0?"#34d399":"#f87171",fontWeight:700}}>{s.sc}</td>
              <td style={{padding:"4px 6px"}}><span style={{color:QCOLORS[s.q],fontWeight:600,fontSize:9}}>{QNAMES[s.q]}</span></td>
            </tr>
          ))}</tbody>
        </table>
      </div>
    </div>
  );
}

