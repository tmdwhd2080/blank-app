          ))}
        </div>
        {tab==="overview"&&<OverviewTab/>}
        {tab==="scatter"&&<ScatterTab/>}
        {tab==="daily"&&<DailyTab/>}
        {tab==="sector"&&<SectorTab/>}
        {tab==="ranking"&&<RankingTab/>}
      </div>
    </div>
  );
}
